context length encode as two little-endian bytes

diff --git a/src/mldsa/mldsa.py b/src/mldsa/mldsa.py
index 2cb390c..be48c7c 100644
--- a/src/mldsa/mldsa.py
+++ b/src/mldsa/mldsa.py
@@ -225,12 +225,13 @@ def public_key_hash(pk: Buffer) -> bytes:
 
 def message_hash(tr: bytes, m: Buffer, ctx: Buffer) -> bytes:
     ctx = memoryview(ctx)
-    if len(ctx) > 255:
-        raise InvalidContextError(f"expected context of at most 255 bytes, got {len(ctx)}")
     h = shake_256()
     h.update(tr)
     h.update(b"\x00")
-    h.update(bytes([len(ctx)]))
+    if len(ctx) < 256:
+        h.update(bytes([len(ctx)]))
+    else:
+        h.update(bytes([len(ctx) % 256, len(ctx) // 256]))
     h.update(ctx)
     h.update(m)
     return h.digest(64)
