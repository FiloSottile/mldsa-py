+
+# Lazy Montgomery arithmetic, mirroring the pq-crystals reference. ZETAS_MONT holds
+# the twiddles in Montgomery form; mont_reduce uses 32-bit truncation and an arithmetic
+# right shift, so the inverse NTT below carries the same int32 overflow behaviour as C.
+_MONT = pow(2, 32, Q)
+_QINV = pow(Q, -1, 1 << 32)
+ZETAS_MONT = [centered_mod(z * _MONT, Q) for z in ZETAS]
+
+
+def mont_reduce(a: int) -> int:
+    t = (a * _QINV) & 0xFFFFFFFF
+    if t >= 1 << 31:
+        t -= 1 << 32
+    return (a - t * Q) >> 32
+
+
+def mont_ntt(coeffs: list[int]) -> list[int]:
+    w = list(coeffs)
+    m = 0
+    for length in [128, 64, 32, 16, 8, 4, 2, 1]:
+        for start in range(0, N, 2 * length):
+            m += 1
+            zeta = ZETAS_MONT[m]
+            for j in range(start, start + length):
+                t = mont_reduce(zeta * w[j + length])
+                w[j + length] = w[j] - t
+                w[j] = w[j] + t
+    return w
+
+
+def inverse_ntt_mont(coeffs: list[int]) -> list[int]:
+    w = list(coeffs)
+    m = 256
+    for length in [1, 2, 4, 8, 16, 32, 64, 128]:
+        for start in range(0, N, 2 * length):
+            m -= 1
+            zeta = -ZETAS_MONT[m]
+            for j in range(start, start + length):
+                t = w[j]
+                s = (t + w[j + length]) & 0xFFFFFFFF  # int32 accumulator: overflows
+                w[j] = s - (1 << 32) if s >= 1 << 31 else s
+                w[j + length] = mont_reduce(zeta * (t - w[j + length]))
+    return [mont_reduce(41978 * v) % Q for v in w]  # 41978 = mont²/256
